#!/bin/bash
# {{ ansible_managed }}
# Runs a Lynis audit and mails the report.
set -u

DATE=$(date +%Y%m%d)
HOST=$(hostname)
LOG_DIR=/var/log/lynis
REPORT="$LOG_DIR/report-${HOST}.${DATE}.log"
DATA="$LOG_DIR/report-data-${HOST}.${DATE}.log"

{% if lynis_deploy_method in ['tar', 'git'] %}
# Lynis finds its include files relative to the current directory
cd "{{ lynis_home }}" || exit 1
LYNIS=./lynis
{% else %}
LYNIS=lynis
PATH=/usr/sbin:/usr/bin:$PATH
{% endif %}
"$LYNIS" audit system --auditor automated --cronjob --report-file "$DATA" > "$REPORT" 2>&1

find "$LOG_DIR" -type f -mtime +{{ lynis_log_expire }} -delete

mail -s "${HOST}: Lynis audit (${DATE})" -r "{{ lynis_report_from }}" \
  "{{ lynis_report_to }}" < "$REPORT"
